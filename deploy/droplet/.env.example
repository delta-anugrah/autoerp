# Contoh .env untuk /opt/autoerp di droplet.
# Yang ASLI dibuat di droplet dan tidak pernah masuk repo. Salin berkas ini ke
# `.env`, isi dua sandinya dengan `openssl rand -base64 32`, lalu simpan
# salinannya di password manager — bukan di chat, bukan di runbook.

# Tag image yang persis sedang jalan. Di-update otomatis oleh workflow deploy;
# JANGAN diedit tangan (itu yang bikin "yang jalan" beda dari "yang dikira jalan").
AUTOERP_IMAGE=ghcr.io/delta-anugrah/autoerp:v1.0.0

# Nama situs = Host header yang diteruskan nginx host. Harus sama persis dengan
# nama situs di dalam bench, kalau tidak Frappe menjawab "Site does not exist".
SITE_NAME=app.smagri.id

# Sandi root MariaDB. Dibutuhkan juga waktu `bench new-site` dan `bench backup`.
DB_PASSWORD=ganti-dengan-openssl-rand-base64-32

# Sandi Administrator situs, dipakai sekali waktu `new-site`.
ADMIN_PASSWORD=ganti-dengan-openssl-rand-base64-32

# Penyetelan gunicorn. Droplet 2 vCPU / 4 GB: 2 worker x 4 thread sudah cukup.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Unggahan: lampiran dan backup lewat sini.
CLIENT_MAX_BODY_SIZE=50m
PROXY_READ_TIMEOUT=120

# --- backup (dibaca .backup-env, BUKAN berkas ini) -------------------------
# Backup harian hidup di berkas terpisah `/opt/autoerp/.backup-env` supaya
# workflow deploy yang menulis ulang .env tidak pernah menghapus kredensialnya.
# Contoh isinya ada di komentar atas `backup.sh`.
